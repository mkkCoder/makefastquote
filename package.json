{
  "name": "makefastquote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Freelance proposal and invoice generator. 100% client-side.",
  "scripts": {
    "dev": "vite",
    "build": "npm run metrics && tsc -b && vite build && node scripts/bundle-budget.mjs",
    "preview": "vite preview --port 4173",
    "metrics": "node scripts/gen-metrics.mjs && node scripts/gen-unicode-metrics.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "e2e": "node scripts/e2e.mjs",
    "shots": "node scripts/screenshots.mjs",
    "check:invisible": "node scripts/check-invisible.mjs",
    "verify": "npm run check:invisible && npm run lint && npm run test && npm run build && npm run audit:contrast && npm run e2e",
    "hero": "node scripts/make-hero.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
